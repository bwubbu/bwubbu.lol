---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Static fallback page per project, for deep links and SEO.
// Styled as a single XP window sitting on the Bliss wallpaper.
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Base title={`${project.data.title} — bwubbu`} description={project.data.summary} bodyClass="docpage">
  <section class="win open active">
    <header class="tbar">
      <h2>{project.slug}.md</h2>
      <a class="wbtn close-b" href="/" aria-label="Back to desktop">✕</a>
    </header>
    <div class="toolbar">
      <a class="tb" href="/"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#3f9d2f"></circle><path d="M14.5 7 9 12l5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back to desktop</a>
    </div>
    <div class="wbody"><div class="wpad prose">
      <h1>{project.data.title}</h1>
      <p class="summary">{project.data.summary}</p>
      {project.data.tech.length > 0 && <ul class="chips">{project.data.tech.map((t) => <li>{t}</li>)}</ul>}
      {(project.data.repo || project.data.demo) && (
        <div class="linkrow">
          {project.data.repo && <a href={project.data.repo} target="_blank" rel="noreferrer">View repo</a>}
          {project.data.demo && <a href={project.data.demo} target="_blank" rel="noreferrer">Live demo</a>}
        </div>
      )}
      <Content />
    </div></div>
  </section>
</Base>
