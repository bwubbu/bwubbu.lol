---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Generates one static page per project file at build time.
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Base title={`${project.data.title} — bwubbu`} description={project.data.summary}>
  <a href="/" class="font-mono text-sm text-magenta hover:underline">&lt; back</a>

  <article class="mt-6">
    <h1 class="font-pixel text-cyan text-xl md:text-2xl leading-relaxed">
      {project.data.title}
    </h1>
    <ul class="flex flex-wrap gap-2 mt-5">
      {project.data.tech.map((t) => (
        <li class="font-mono text-xs text-neon border border-edge px-2 py-1">{t}</li>
      ))}
    </ul>

    <!-- Markdown body renders here, styled by Tailwind Typography-free prose classes -->
    <div class="mt-8 font-mono text-crt text-sm leading-relaxed space-y-4 [&_h2]:font-pixel [&_h2]:text-magenta [&_h2]:text-sm [&_h2]:mt-8 [&_h2]:mb-2 [&_a]:text-cyan [&_a]:underline [&_code]:text-neon">
      <Content />
    </div>
  </article>
</Base>
