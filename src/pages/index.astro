---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import XpWindow from '../components/XpWindow.astro';
import Icon from '../components/Icon.astro';
import Boot from '../components/Boot.astro';
import Blubamp from '../components/Blubamp.astro';
import Taskbar from '../components/Taskbar.astro';
import StartMenu from '../components/StartMenu.astro';
import BrowserWindow from '../components/BrowserWindow.astro';
import StickyNote from '../components/StickyNote.astro';
import WiiMenu from '../components/WiiMenu.astro';
import PS2Experience from '../components/PS2Experience.astro';
import Wallpapers from '../components/Wallpapers.astro';

// Pull projects at build time: featured first, then newest, bodies compiled.
const entries = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = await Promise.all(
  entries.map(async (p) => ({ ...p, Content: (await p.render()).Content }))
);

const EMAIL = 'hello@bwubbu.lol';
const GITHUB = 'https://github.com/bwubbu';

const DESKTOP_ICONS = [
  { open: 'browser', icon: 'globe', label: 'about.html' },
  { open: 'ps2', icon: 'card', label: 'Experience' },
  { open: 'wii', icon: 'wiimote', label: 'Projects' },
  { open: 'contact', icon: 'mail', label: 'Contact Me' },
  { open: 'wallpapers', icon: 'folder', label: 'Wallpapers' },
  { open: 'trash', icon: 'bin', label: 'Recycle Bin' },
] as const;
---

<Base bodyClass="desktop">
  <Boot />

  <!-- desktop context menu -->
  <div class="ctx" id="ctx">
    <button class="dis">Arrange Icons By &nbsp;▸</button>
    <button id="ctx-refresh">Refresh</button>
    <hr />
    <button class="dis">Paste</button>
    <button class="dis">Paste Shortcut</button>
    <hr />
    <button class="dis">New &nbsp;▸</button>
    <hr />
    <button id="ctx-props">Properties</button>
  </div>

  <div class="scene" id="scene">
    <div class="clouds"></div>
    <div class="hill">
      <svg viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="grass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#a8d23e"></stop><stop offset=".25" stop-color="#7cb92f"></stop>
            <stop offset=".6" stop-color="#4d8f22"></stop><stop offset="1" stop-color="#2f671a"></stop>
          </linearGradient>
          <linearGradient id="grass2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8cbf35"></stop><stop offset="1" stop-color="#3d7a1e"></stop>
          </linearGradient>
        </defs>
        <path d="M0,150 Q250,30 560,90 T1200,40 V300 H0 Z" fill="url(#grass2)" opacity=".85"></path>
        <path d="M0,190 Q320,70 700,140 T1200,120 V300 H0 Z" fill="url(#grass)"></path>
      </svg>
    </div>

    <nav class="icons" aria-label="Desktop">
      {DESKTOP_ICONS.map((i) => (
        <button class="dicon" data-open={i.open}>
          <Icon name={i.icon} />
          <span>{i.label}</span>
        </button>
      ))}
    </nav>

    <Blubamp />

    <BrowserWindow email={EMAIL} github={GITHUB} />

    <StickyNote />

    <XpWindow id="contact" title="New Message" style="left:24%;top:32%" menubar={['File', 'Edit', 'Insert', 'Format', 'Help']}>
      <div class="wbody"><div class="wpad form">
        <div class="mailrow"><label for="m-to">To:</label><input id="m-to" value={EMAIL} readonly /></div>
        <div class="mailrow"><label for="m-sub">Subject:</label><input id="m-sub" placeholder="you're hired" /></div>
        <textarea class="mailbody" id="m-body" placeholder="say hi…"></textarea>
        <div class="sendrow"><button class="xbtn" id="send">📨 Send</button></div>
      </div></div>
    </XpWindow>

    <XpWindow id="trash" title="Recycle Bin" style="left:38%;top:26%" menubar={['File', 'Edit', 'View', 'Help']}>
      <div class="wbody">
        <div class="filelist">
          <button class="file" data-err="crt-theme.css cannot be restored. The neon terminal era is over. Let it go.">
            <svg viewBox="0 0 42 42"><rect x="8" y="4" width="26" height="34" rx="2" fill="#0b0b12" stroke="#555" stroke-width="1.5"></rect><path d="M12 14l5 4-5 4M20 24h9" stroke="#39ff14" stroke-width="2" stroke-linecap="round" fill="none"></path></svg>
            crt-theme.css<small>the old site</small>
          </button>
          <button class="file" data-err="typewriter.tsx has been deleted. It typed. It deleted. It typed again. We'll miss it.">
            <svg viewBox="0 0 42 42"><rect x="8" y="4" width="26" height="34" rx="2" fill="#0b0b12" stroke="#555" stroke-width="1.5"></rect><path d="M12 20h12" stroke="#ff2e97" stroke-width="2.5" stroke-linecap="round"></path><rect x="26" y="16" width="4" height="8" fill="#ff2e97"></rect></svg>
            typewriter.tsx<small>the old hero</small>
          </button>
        </div>
      </div>
      <div class="statusbar"><span>2 objects</span><span>Recycle Bin</span></div>
    </XpWindow>

    <XpWindow id="error" title="Error" style="left:34%;top:36%" dialog min={false}>
      <div class="wpad">
        <svg class="errico" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="#d63b1f" stroke="#7e1c09" stroke-width="1"></circle><path d="M10.5 10.5 21.5 21.5 M21.5 10.5 10.5 21.5" stroke="#fff" stroke-width="3.4" stroke-linecap="round"></path></svg>
        <p id="err-msg" class="errmsg"></p>
      </div>
      <div class="btnrow"><button class="xbtn" data-close>OK</button></div>
    </XpWindow>

    <WiiMenu projects={projects.map((p) => ({ slug: p.slug, ...p.data, Content: p.Content }))} />
    <PS2Experience />
    <Wallpapers />
  </div>

  <!-- balloon -->
  <div class="balloon" id="balloon">
    <b><span class="bi">i</span> Welcome to blubOS <span class="bx" id="bx">✕</span></b>
    New portfolio detected. Double-click <u>Projects</u> to have a look around.
  </div>

  <StartMenu email={EMAIL} github={GITHUB} />
  <Taskbar />
</Base>

<script>
  import '../scripts/desktop.ts';
</script>
