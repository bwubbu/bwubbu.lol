---
// The "My Projects" Explorer window: toolbar, address bar, task pane,
// and one file per content-collection entry (opened by desktop.ts).
import XpWindow from './XpWindow.astro';
import Icon from './Icon.astro';

interface Props {
  projects: { slug: string; date: string }[];
  email: string;
  github: string;
}
const { projects, email, github } = Astro.props;
---

<XpWindow
  id="projects"
  title="My Projects"
  style="left:16%;top:6%;width:580px"
  max
  menubar={['File', 'Edit', 'View', 'Favorites', 'Tools', 'Help']}
>
  <Icon name="folder" class="ticon" stroke={2} slot="icon" />
  <div class="toolbar">
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#3f9d2f"></circle><path d="M14.5 7 9 12l5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back <span class="caret">▾</span></button>
    <button class="tb dis"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#b9c4b6"></circle><path d="M9.5 7 15 12l-5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="caret">▾</span></button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M3 9 q0-2 2-2 h5 l2 2 h9 q2 0 2 2 v8 q0 2-2 2 H5 q-2 0-2-2 Z" fill="#ffdf7e" stroke="#b58618" stroke-width="1.4"></path><path d="M12 6 12 1.5 M9.5 4 12 1.5 14.5 4" fill="none" stroke="#3f9d2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
    <div class="tbsep"></div>
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="5.5" fill="none" stroke="#4a7ab5" stroke-width="2.2"></circle><path d="M14.5 14.5 20 20" stroke="#4a7ab5" stroke-width="2.6" stroke-linecap="round"></path></svg>Search</button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M3 9 q0-2 2-2 h5 l2 2 h9 q2 0 2 2 v8 q0 2-2 2 H5 q-2 0-2-2 Z" fill="#ffdf7e" stroke="#b58618" stroke-width="1.4"></path></svg>Folders</button>
  </div>
  <div class="addrbar">
    <label>Address</label>
    <div class="path">📁 C:\Documents and Settings\Blub\My Projects</div>
    <span class="go"><i>➜</i>Go</span>
  </div>
  <div class="wbody">
    <aside class="taskpane">
      <div class="tgroup">
        <h4>File and Folder Tasks</h4>
        <div>
          <a href={github} target="_blank" rel="noreferrer">View source on GitHub</a>
          <a href={`mailto:${email}`}>E-mail Blub</a>
        </div>
      </div>
      <div class="tgroup">
        <h4>Details</h4>
        <div><p><b>My Projects</b><br />File Folder<br />Everything in src/content/projects/ shows up here.</p></div>
      </div>
    </aside>
    <div class="filelist">
      {projects.map((p) => (
        <button class="file" data-open={`proj-${p.slug}`}>
          <Icon name="doc" />
          {p.slug}.md<small>{p.date}</small>
        </button>
      ))}
    </div>
  </div>
  <div class="statusbar">
    <span>{projects.length} object{projects.length === 1 ? '' : 's'}</span>
    <span>My Computer</span>
  </div>
</XpWindow>
