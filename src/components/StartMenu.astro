---
import Icon from './Icon.astro';

interface Props {
  email: string;
  github: string;
}
const { email, github } = Astro.props;
---

<div class="startmenu" id="startmenu">
  <div class="smhead"><span class="avatar">B</span> Blub</div>
  <div class="smcols">
    <div class="smcol left">
      <button class="smitem" data-open="projects">
        <Icon name="folder" stroke={2} />
        <span><b>My Projects</b><br /><small>the good stuff</small></span>
      </button>
      <button class="smitem" data-open="browser">
        <Icon name="globe" stroke={2} />
        <span><b>bwubbu Explorer</b><br /><small>about.html</small></span>
      </button>
      <button class="smitem" data-open="contact">
        <Icon name="mail" stroke={2} />
        <span><b>New Message</b><br /><small>say hello</small></span>
      </button>
      <div class="smsep"></div>
      <button class="smitem allprog" id="allprog">All Programs <i>▸</i></button>
    </div>
    <div class="smcol right">
      <a class="smitem" href={github} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#24292f"></circle><path d="M12 5.5a6.5 6.5 0 0 0-2 12.7c.3 0 .4-.14.4-.3v-1.2c-1.7.35-2-.75-2-.75-.3-.7-.7-.9-.7-.9-.6-.4 0-.4 0-.4.6 0 1 .6 1 .6.6 1 1.5.7 1.9.55 0-.4.2-.7.4-.9-1.4-.15-2.9-.7-2.9-3.2 0-.7.25-1.3.65-1.75-.06-.16-.28-.8.07-1.68 0 0 .54-.17 1.76.67a6 6 0 0 1 3.2 0c1.2-.84 1.75-.67 1.75-.67.35.88.13 1.52.07 1.68.4.45.65 1.05.65 1.75 0 2.5-1.5 3.05-2.9 3.2.22.2.42.57.42 1.15v1.7c0 .17.1.32.4.3A6.5 6.5 0 0 0 12 5.5Z" fill="#fff"></path></svg>
        GitHub
      </a>
      <a class="smitem" href={`mailto:${email}`}>
        <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" fill="#5a8ef0"></rect><path d="M3 7 12 14 21 7" fill="none" stroke="#fff" stroke-width="1.8"></path></svg>
        E-mail
      </a>
      <div class="smsep"></div>
      <button class="smitem" data-open="trash">
        <Icon name="bin" stroke={2} />
        Recycle Bin
      </button>
    </div>
  </div>
  <div class="smfoot">
    <button class="lo" id="logoff"><i>⇦</i>Log Off</button>
    <button class="to" id="turnoff"><i>⏻</i>Turn Off Computer</button>
  </div>
</div>
