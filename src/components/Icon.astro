---
// Shared XP-style icons, hand-drawn SVG. Size comes from the context
// (.dicon svg, .file svg, .ticon, .smitem svg); pass class through.
interface Props {
  name: 'folder' | 'doc' | 'globe' | 'mail' | 'bin';
  class?: string;
  stroke?: number; // bump to 2 for small (16-26px) renderings
}
const { name, class: cls, stroke = 1.5 } = Astro.props;
---

{name === 'folder' && (
  <svg class={cls} viewBox="0 0 42 42"><path d="M3 12 q0-3 3-3 h10 l4 4 h16 q3 0 3 3 v17 q0 3-3 3 H6 q-3 0-3-3 Z" fill="#ffe9a6" stroke="#b58618" stroke-width={stroke}></path><path d="M3 17 h36 v14 q0 3-3 3 H6 q-3 0-3-3 Z" fill="#ffdf7e" stroke="#b58618" stroke-width={stroke}></path></svg>
)}
{name === 'doc' && (
  <svg class={cls} viewBox="0 0 42 42"><rect x="8" y="4" width="26" height="34" rx="2" fill="#fff" stroke="#8a97ad" stroke-width={stroke}></rect><path d="M12 12h18M12 17h18M12 22h18M12 27h10" stroke="#9db4d8" stroke-width="2" stroke-linecap="round"></path></svg>
)}
{name === 'globe' && (
  <svg class={cls} viewBox="0 0 42 42"><circle cx="21" cy="21" r="16" fill="#3a7cd8" stroke="#1c4f9e" stroke-width={stroke}></circle><ellipse cx="21" cy="21" rx="7" ry="16" fill="none" stroke="#bcd8f7" stroke-width={stroke}></ellipse><path d="M5.5 16h31M5.5 26h31" stroke="#bcd8f7" stroke-width={stroke} fill="none"></path><path d="M8 32 Q21 20 38 15" fill="none" stroke="#f6b91e" stroke-width="3" stroke-linecap="round"></path></svg>
)}
{name === 'mail' && (
  <svg class={cls} viewBox="0 0 42 42"><rect x="4" y="9" width="34" height="24" rx="2" fill="#f4f8ff" stroke="#8a97ad" stroke-width={stroke}></rect><path d="M5 11 21 24 37 11" fill="none" stroke="#5a8ef0" stroke-width="2"></path><path d="M5 31 15 21M37 31 27 21" stroke="#c3cfe2" stroke-width={stroke}></path></svg>
)}
{name === 'bin' && (
  <svg class={cls} viewBox="0 0 42 42"><path d="M10 13 h22 l-2.5 24 q-.3 3-3 3 H15.5 q-2.7 0-3-3 Z" fill="#dfeefc" opacity=".85" stroke="#7a93b5" stroke-width={stroke}></path><ellipse cx="21" cy="13" rx="12" ry="3.4" fill="#c9dff5" stroke="#7a93b5" stroke-width={stroke}></ellipse><path d="M15 18l1.4 17M21 18v17M27 18l-1.4 17" stroke="#9cb8d8" stroke-width={stroke}></path></svg>
)}
