---
// One draggable window per project. Renders the frontmatter (title, summary,
// tech, links) plus the compiled markdown body. When `embed` is set and the
// demo host allows framing, it also shows a live in-window preview of the site.
import XpWindow from './XpWindow.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  tech: string[];
  repo?: string;
  demo?: string;
  embed?: boolean;
  index: number;
  Content: any;
}
const { slug, title, summary, tech, repo, demo, embed, index, Content } = Astro.props;
---

<XpWindow
  id={`proj-${slug}`}
  title={`${slug}.md`}
  style={`left:${26 + index * 4}%;top:${16 + index * 5}%;width:520px;height:480px`}
  max
>
  <div class="wbody"><div class="wpad prose">
    <h1>{title}</h1>
    <p class="summary">{summary}</p>

    {embed && demo && (
      <figure class="preview">
        <div class="preview-bar">
          <span class="pd r"></span><span class="pd y"></span><span class="pd g"></span>
          <span class="preview-url">{demo}</span>
        </div>
        <iframe class="preview-frame" src={demo} title={`${title} live preview`} loading="lazy"></iframe>
      </figure>
    )}

    {tech.length > 0 && <ul class="chips">{tech.map((t) => <li>{t}</li>)}</ul>}
    {(repo || demo) && (
      <div class="linkrow">
        {repo && <a href={repo} target="_blank" rel="noreferrer">View repo</a>}
        {demo && <a href={demo} target="_blank" rel="noreferrer">Live demo</a>}
      </div>
    )}
    <Content />
  </div></div>
</XpWindow>

<style>
  .preview {
    margin: 10px 0 4px; border: 1px solid #7f9db9; border-radius: 4px; overflow: hidden;
    background: #fff; box-shadow: 0 1px 3px rgba(0, 0, 0, .18);
  }
  .preview-bar {
    display: flex; align-items: center; gap: 5px; padding: 4px 7px;
    background: linear-gradient(#f4f8fd, #dce7f5); border-bottom: 1px solid #b9cbe4;
  }
  .pd { width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .18); }
  .pd.r { background: #ff6159; } .pd.y { background: #ffbd2e; } .pd.g { background: #28c840; }
  .preview-url {
    margin-left: 6px; font-size: 10px; color: #5b6b82;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--font-ui);
  }
  .preview-frame { display: block; width: 100%; height: 300px; border: 0; background: #fff; }
</style>
