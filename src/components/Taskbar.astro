---
// Start button, quick launch, running-window buttons (filled by desktop.ts), tray.
---

<footer class="taskbar">
  <button class="startbtn" id="startbtn" aria-expanded="false">
    <svg width="19" height="19" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M6 18 Q18 10 30 16 L28 30 Q16 25 8 31 Z" fill="#e13d2f"></path>
      <path d="M34 17 Q46 11 58 19 L56 32 Q46 26 32 31 Z" fill="#7ab648"></path>
      <path d="M9 35 Q17 30 27 34 L25 48 Q17 44 7 49 Z" fill="#3a7cd8"></path>
      <path d="M31 35 Q43 30 55 36 L53 50 Q43 44 29 49 Z" fill="#f6b91e"></path>
    </svg>
    start
  </button>
  <div class="qlaunch">
    <button class="qbtn" id="showdesk" title="Show Desktop">
      <svg viewBox="0 0 24 24"><rect x="3" y="4" width="15" height="11" rx="1.5" fill="#dbe9fb" stroke="#5a7db0" stroke-width="1.4"></rect><path d="M8 18h5M10.5 15v3" stroke="#5a7db0" stroke-width="1.4"></path><path d="M15 13l6 3-3 1-1 3z" fill="#fff" stroke="#333" stroke-width="1.2"></path></svg>
    </button>
    <button class="qbtn" data-open="contact" title="New Message">
      <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="1.5" fill="#f4f8ff" stroke="#5a7db0" stroke-width="1.4"></rect><path d="M4 8 12 14 20 8" fill="none" stroke="#5a8ef0" stroke-width="1.6"></path></svg>
    </button>
  </div>
  <div class="taskbtns" id="taskbtns"></div>
  <div class="tray">
    <button class="hidebtn" title="Hide inactive icons">◂</button>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17h10v2H4zM4 15c0-4 2-7 5-7s5 3 5 7" fill="none" stroke="#fff" stroke-width="1.6"></path><path d="M16 9c3 0 5 2.6 5 6v2h-4" fill="none" stroke="#fff" stroke-width="1.6"></path></svg>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="12" height="9" rx="1" fill="none" stroke="#fff" stroke-width="1.5"></rect><path d="M16 10h3l1 2v4h-4zM7 16v2M13 16v2" stroke="#fff" stroke-width="1.5" fill="none"></path></svg>
    <span id="clock">--:--</span>
  </div>
</footer>
