---
// Boot splash, powered-off screen, and the Turn Off Computer dialog.
// All behaviour lives in src/scripts/desktop.ts.
---

<div class="boot" id="boot">
  <div class="bootlogo">
    <svg class="flag" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M6 18 Q18 10 30 16 L28 30 Q16 25 8 31 Z" fill="#e13d2f"></path>
      <path d="M34 17 Q46 11 58 19 L56 32 Q46 26 32 31 Z" fill="#7ab648"></path>
      <path d="M9 35 Q17 30 27 34 L25 48 Q17 44 7 49 Z" fill="#3a7cd8"></path>
      <path d="M31 35 Q43 30 55 36 L53 50 Q43 44 29 49 Z" fill="#f6b91e"></path>
    </svg>
    <p><i>bwubbu presents</i>blubOS<sup>xp</sup></p>
  </div>
  <div class="bootbar"><i><b></b></i></div>
</div>
<!-- runs synchronously during parse so return visits never flash the boot screen -->
<script is:inline>
  if (sessionStorage.getItem('xpBooted')) document.getElementById('boot').classList.add('done');
</script>

<div class="off" id="off">
  <p>it is now safe to close this tab.<small>(or click anywhere to boot back up)</small></p>
</div>

<div class="offdlg" id="offdlg">
  <div class="offbox">
    <header>Turn off computer</header>
    <div class="mid">
      <button class="offopt" id="standby"><i class="standby">⏾</i>Stand By</button>
      <button class="offopt" id="poweroff"><i class="power">⏻</i>Turn Off</button>
      <button class="offopt" id="restart"><i class="restart">⟳</i>Restart</button>
    </div>
    <footer><button class="xbtn" id="offcancel">Cancel</button></footer>
  </div>
</div>
