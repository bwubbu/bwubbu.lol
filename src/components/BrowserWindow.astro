---
// about.html in "bwubbu Explorer": browser chrome around the MySpace-skinned
// GitHub profile. Content mirrors github.com/bwubbu 1:1 — sidebar details,
// profile README (banner + badges + bullets), pinned repos, contribution
// graph (mood ring), followers, and the issue guestbook. The skin stays 2004.
import XpWindow from './XpWindow.astro';
import Icon from './Icon.astro';

interface Props {
  email: string;
  github: string;
}
const { email, github } = Astro.props;
const GHUSER = github.split('/').pop();
const LINKEDIN = 'https://www.linkedin.com/in/rudzaidan-rosdi-6156a0213';
const BANNER = `https://raw.githubusercontent.com/${GHUSER}/${GHUSER}/main/header.png`;
---

<XpWindow
  id="browser"
  title="Blub's homepage - bwubbu Explorer"
  style="left:14%;top:4%;width:960px;height:620px"
  max
  menubar={['File', 'Edit', 'View', 'Favorites', 'Tools', 'Help']}
>
  <Icon name="globe" class="ticon" stroke={2} slot="icon" />
  <div class="toolbar">
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#3f9d2f"></circle><path d="M14.5 7 9 12l5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button>
    <button class="tb dis"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#b9c4b6"></circle><path d="M9.5 7 15 12l-5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
    <div class="tbsep"></div>
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#d63b1f"></circle><path d="M8.5 8.5 15.5 15.5M15.5 8.5 8.5 15.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path></svg>Stop</button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M19 12a7 7 0 1 1-2-4.9" fill="none" stroke="#3f9d2f" stroke-width="2.4" stroke-linecap="round"></path><path d="M17.5 3v4.5H13" fill="none" stroke="#3f9d2f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Refresh</button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7" fill="none" stroke="#4a7ab5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 10v9h12v-9" fill="none" stroke="#4a7ab5" stroke-width="2.2" stroke-linejoin="round"></path></svg>Home</button>
  </div>
  <div class="addrbar">
    <label>Address</label>
    <div class="path"><Icon name="globe" class="favi" stroke={2} /> http://www.bwubbu.lol/about.html</div>
    <span class="go"><i>➜</i>Go</span>
  </div>
  <div class="wbody"><div class="webpage" id="webpage">
    <div class="mshead">
      <span class="mslogo">blubspace.com</span>
      <span class="mssearch">Search: <i class="msinput"></i> <b class="msgo">Go</b></span>
      <span class="mslinks">Help | SignUp</span>
    </div>
    <div class="msnav">Home | Browse | Search | Invite | Film | Mail | Blog | Favorites | Forum | Groups | Events | Videos | Music | Classifieds</div>
    <div class="profile">
      <div class="pcol-l">
        <h1 class="pname">Blub <small class="pnick">(@{GHUSER})</small></h1>
        <div class="pmain">
          <span class="avatarbig"><img src="/profile-pic.jpg" alt="Blub" id="pavatar" data-user={GHUSER} /></span>
          <div>
            "shipping side projects"<br /><br />
            Kuala Lumpur, MALAYSIA<br />
            <span class="onlinenow">ONLINE NOW!</span><br />
            Last Login: today
          </div>
        </div>
        <p class="pview">View My: <button class="plink" data-open="wii">Projects</button> | <button class="plink" data-err="pics.zip is still uploading. 56k, please understand.">Pics</button></p>

        <div class="pbox">
          <h5>Contacting Blub</h5>
          <div class="contact-grid">
            <button class="plink" data-err="You are now following Blub. Blub felt that."><svg class="bi" viewBox="0 0 24 24"><path d="M12 20S4 14.5 4 9.2A3.8 3.8 0 0 1 12 7a3.8 3.8 0 0 1 8 2.2C20 14.5 12 20 12 20Z"></path></svg>Follow</button>
            <button class="plink" data-open="contact"><svg class="bi" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M4 7l8 6 8-6"></path></svg>Send Message</button>
            <button class="plink" data-err="Blub accepts sponsorship in old MP3 players and mechanical switches."><svg class="bi" viewBox="0 0 24 24"><path d="M12 3l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 16.9 6.7 19.5l1.1-6L3.4 9.3l6-.8Z"></path></svg>Sponsor</button>
            <button class="plink" data-err="You cannot block Blub. Blub owns this computer."><svg class="bi" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="M6.5 6.5l11 11"></path></svg>Block or Report</button>
          </div>
        </div>

        <div class="pbox"><h5>blubspace URL:</h5><div class="inner"><a href="https://bwubbu.lol">https://bwubbu.lol</a></div></div>

        <table class="ptable">
          <tr><th class="thead" colspan="2">Blub's Details</th></tr>
          <tr><th>Username:</th><td><a href={github} target="_blank" rel="noreferrer">{GHUSER}</a></td></tr>
          <tr><th>Followers:</th><td id="gh-followers">at least 4</td></tr>
          <tr><th>Following:</th><td id="gh-following">a lucky few</td></tr>
          <tr><th>Public Repos:</th><td id="gh-repos">several</td></tr>
          <tr><th>Member Since:</th><td id="gh-since">the before times</td></tr>
          <tr><th>Location:</th><td>Kuala Lumpur, Malaysia</td></tr>
          <tr><th>Occupation:</th><td>Software Engineer (Frontend)</td></tr>
        </table>
      </div>

      <div class="pcol-r">
        <div class="rsec">
          <h4 class="orangetitle">{GHUSER} / README.md</h4>
          <img class="msbanner" src={BANNER} alt="bwubbu banner" loading="lazy" />
          <p class="badges">
            <span class="chip blue"><b>profile views</b><i id="pviews">4216</i></span>
            <span class="chip"><b>followers</b><i id="badge-followers">4</i></span>
          </p>
          <ul class="readme">
            <li>🏫 University of Malaya + Yokohama National University Graduate</li>
            <li>🌱 Software Engineer Specialising in Frontend Development</li>
            <li>⌨️ I like building keyboards and collect old MP3 players</li>
            <li>🎮 Do wacky stuff with my ESP32 when I'm bored</li>
            <li>☁️ Currently exploring DevOps and Automation</li>
            <li>💻 Connect with me on <a href={LINKEDIN} target="_blank" rel="noreferrer">LinkedIn</a> or <a href={`mailto:${email}`}>say hi</a></li>
          </ul>
        </div>

        <div class="rsec">
          <h4 class="orangetitle">Pinned <button class="plink" data-err="Pinning a repo is the strongest form of self-love Blub knows.">[📌]</button></h4>
          <div class="pins" id="pinned">
            <div class="pin"><a>this-website</a><p>you are standing inside it right now</p><small><i class="dot"></i> Astro</small></div>
            <div class="pin"><a>secret.zip</a><p>do not open</p><small><i class="dot"></i> ???</small></div>
          </div>
        </div>

        <div class="rsec">
          <h4 class="orangetitle">Blub's Mood Ring</h4>
          <p>Current mood: <b class="red" id="mood-now">shipping</b> ✨</p>
          <div class="mood" id="moodgrid" data-user={GHUSER}></div>
          <p class="moodkey"><small>the last 13 weeks of github contributions, as read by a mood ring — pale ♡ hot pink</small></p>
        </div>

        <div class="rsec">
          <h4 class="orangetitle">Blub's Friend Space</h4>
          <p>Blub has <b class="red" id="fcount">4</b> friends.</p>
          <div class="top8" id="top8" data-user={GHUSER}>
            <figure><figcaption>the debug duck</figcaption><i>DD</i></figure>
            <figure><figcaption>old rig (P4)</figcaption><i>P4</i></figure>
            <figure><figcaption>56k modem</figcaption><i>56k</i></figure>
            <figure><figcaption>blubamp</figcaption><i>♫</i></figure>
          </div>
          <p class="viewall"><b>[<a href={`${github}?tab=followers`} target="_blank" rel="noreferrer">View All of Blub's Friends</a>]</b></p>
        </div>

        <div class="rsec">
          <h4 class="orangetitle">Blub's Friends Comments</h4>
          <p>Displaying <b class="red" id="cmt-shown">2</b> of <b class="red" id="cmt-total">2</b> comments (<a href="https://github.com/bwubbu/bwubbu.lol/issues/4" target="_blank" rel="noreferrer">Add Comment</a>)</p>
          <table class="cmt" id="cmts" data-repo="bwubbu/bwubbu.lol" data-issue="4">
            <tr>
              <td class="who">the debug duck<br /><i>DD</i></td>
              <td class="what"><b>quack</b><br /><br />(this means ship it)</td>
            </tr>
            <tr>
              <td class="who">56k modem<br /><i>56k</i></td>
              <td class="what"><b>EEEEEE-AWWWWW kshhhhh</b><br /><br />thanks for waiting for me all those years</td>
            </tr>
          </table>
        </div>

      </div>
    </div>
    <p class="foot">©2003-2026 blubspace.com. All Rights Reserved.</p>
  </div></div>
  <div class="statusbar"><span>Done</span><span><Icon name="globe" class="favi" stroke={2} /> Internet</span></div>
</XpWindow>
