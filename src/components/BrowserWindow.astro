---
// about.html in "bwubbu Explorer": browser chrome around the MySpace-style
// glitter profile. This is the file to edit when personalising the page.
import XpWindow from './XpWindow.astro';
import Icon from './Icon.astro';

interface Props {
  email: string;
  github: string;
}
const { email, github } = Astro.props;
---

<XpWindow
  id="browser"
  title="Blub's homepage - bwubbu Explorer"
  style="left:24%;top:5%;width:740px;height:520px"
  max
  menubar={['File', 'Edit', 'View', 'Favorites', 'Tools', 'Help']}
>
  <Icon name="globe" class="ticon" stroke={2} slot="icon" />
  <div class="toolbar">
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#3f9d2f"></circle><path d="M14.5 7 9 12l5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Back</button>
    <button class="tb dis"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#b9c4b6"></circle><path d="M9.5 7 15 12l-5.5 5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
    <div class="tbsep"></div>
    <button class="tb"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#d63b1f"></circle><path d="M8.5 8.5 15.5 15.5M15.5 8.5 8.5 15.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path></svg>Stop</button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M19 12a7 7 0 1 1-2-4.9" fill="none" stroke="#3f9d2f" stroke-width="2.4" stroke-linecap="round"></path><path d="M17.5 3v4.5H13" fill="none" stroke="#3f9d2f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>Refresh</button>
    <button class="tb"><svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7" fill="none" stroke="#4a7ab5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 10v9h12v-9" fill="none" stroke="#4a7ab5" stroke-width="2.2" stroke-linejoin="round"></path></svg>Home</button>
  </div>
  <div class="addrbar">
    <label>Address</label>
    <div class="path"><Icon name="globe" class="favi" stroke={2} /> http://www.bwubbu.lol/about.html</div>
    <span class="go"><i>➜</i>Go</span>
  </div>
  <div class="wbody"><div class="webpage" id="webpage">
    <span class="spark" style="left:6%;top:15%">✦</span>
    <span class="spark" style="left:88%;top:12%">✧</span>
    <span class="spark" style="left:14%;top:48%">✧</span>
    <span class="spark" style="left:92%;top:42%">✦</span>
    <span class="spark" style="left:8%;top:78%">★</span>
    <span class="spark" style="left:85%;top:72%">✦</span>
    <span class="spark" style="left:48%;top:8%">✧</span>
    <span class="spark" style="left:55%;top:88%">✦</span>
    <div class="mshead"><span>blubspace <i>· a place for blubs</i></span><span>Home | Browse | Search | Help</span></div>
    <div class="marq"><span>✧･ﾟ WELCOME TO Blub's CORNER OF THE WEB ･ﾟ✧ thanks 4 stopping by!!! sign the guestbook or else (◕‿◕✿) ✧･ﾟ pls no hotlinking my glitters ･ﾟ✧</span></div>
    <div class="profile">
      <div class="pcol-l">
        <div class="pbox">
          <h1>~*~ Blub ~*~</h1>
          <div class="pmain">
            <span class="avatarbig"><img src="/profile-pic.jpg" alt="Blub" /></span>
            <div>
              developer / builder / MY<br />
              <span class="onlinenow">★ ONLINE NOW!</span><br />
              Last Login: today<br />
              <small>(bwubbu in-game)</small>
            </div>
          </div>
          <p class="pview">View My: <button class="plink" data-open="projects">Projects</button> | <button class="plink" data-err="pics.zip is still uploading. 56k, please understand.">Pics</button></p>
        </div>
        <div class="pbox">
          <h5>Contacting Blub</h5>
          <div class="contact-grid">
            <button class="plink" data-err="Friend request sent. It has been pending since 2007."><svg class="bi" viewBox="0 0 24 24"><path d="M12 20S4 14.5 4 9.2A3.8 3.8 0 0 1 12 7a3.8 3.8 0 0 1 8 2.2C20 14.5 12 20 12 20Z"></path></svg>Add to Friends</button>
            <button class="plink" data-open="contact"><svg class="bi" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M4 7l8 6 8-6"></path></svg>Send Message</button>
            <button class="plink" data-err="Away message: brb compiling (since 2019)"><svg class="bi" viewBox="0 0 24 24"><path d="M4 5h16v10H9l-4 4V5Z"></path></svg>Instant Message</button>
            <button class="plink" data-err="You cannot block Blub. Blub owns this computer."><svg class="bi" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="M6.5 6.5l11 11"></path></svg>Block User</button>
            <button class="plink" data-err="Added to favorites!! (not really — press ctrl+d)"><svg class="bi" viewBox="0 0 24 24"><path d="M12 3l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 16.9 6.7 19.5l1.1-6L3.4 9.3l6-.8Z"></path></svg>Add to Favorites</button>
            <button class="plink" data-err="Ranked #1. There are no other users on blubspace."><svg class="bi" viewBox="0 0 24 24"><path d="M5 20V10M12 20V4M19 20v-7"></path></svg>Rank User</button>
          </div>
        </div>
        <div class="pbox"><h5>URL</h5><div class="inner">https://bwubbu.lol</div></div>
        <div class="pbox">
          <h5>Blub's Interests</h5>
          <table class="ptable">
            <tr><th>General</th><td>edit me in src/components/BrowserWindow.astro</td></tr>
            <tr><th>Music</th><td>nightcore remixes of songs that were fine before</td></tr>
            <tr><th>Games</th><td>ask bwubbu (that's me, in-game)</td></tr>
            <tr><th>Heroes</th><td>the debug duck (see friend space)</td></tr>
          </table>
        </div>
        <div class="pbox"><h5>Profile Song</h5><div class="inner">♫ nightcore remix (192kbps)<br /><i>autoplay blocked. you're welcome.</i></div></div>
      </div>
      <div class="pcol-r">
        <div class="msbox">
          <h5>Blub is in your extended network</h5>
          <div class="inner"><b class="on">● ONLINE NOW</b> — "collecting glitters and shipping side projects ✧"<br />mood: nostalgic (✿◠‿◠)</div>
        </div>
        <div class="blurb">
          <h4>About me:</h4>
          <div class="inner">developer / builder / tinkerer / human.<br />who you are, what you do — edit me in src/components/BrowserWindow.astro.<br /><br />my rig: Pentium 4 · 512MB RAM · 56k modem (please be patient, images loading)</div>
        </div>
      </div>
    </div>
  </div></div>
  <div class="statusbar"><span>Done</span><span><Icon name="globe" class="favi" stroke={2} /> Internet</span></div>
</XpWindow>
